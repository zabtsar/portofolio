<script>
  // Fade-up on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

  // ── PROJECT SLIDER ──
  const sliderState = {};

  function initSliders() {
    document.querySelectorAll('.proj-img-slider').forEach(slider => {
      const id = slider.id;
      const imgs = slider.querySelectorAll('.proj-slides img');
      sliderState[id] = 0;
      const dotsContainer = slider.querySelector('.slide-dots');
      imgs.forEach((_, i) => {
        const dot = document.createElement('button');
        dot.className = 'slide-dot' + (i === 0 ? ' active' : '');
        dot.onclick = (e) => { e.stopPropagation(); goToSlide(id, i); };
        dotsContainer.appendChild(dot);
      });
      if (imgs.length <= 1) {
        slider.querySelectorAll('.slide-btn').forEach(b => b.style.display = 'none');
        dotsContainer.style.display = 'none';
      }
    });
  }

  function goToSlide(id, index) {
    const slider = document.getElementById(id);
    const total = slider.querySelectorAll('.proj-slides img').length;
    sliderState[id] = (index + total) % total;
    slider.querySelector('.proj-slides').style.transform = `translateX(-${sliderState[id] * 100}%)`;
    slider.querySelectorAll('.slide-dot').forEach((d, i) => d.classList.toggle('active', i === sliderState[id]));
  }

  function slideProj(id, dir) {
    event.stopPropagation();
    goToSlide(id, sliderState[id] + dir);
  }

  function openProjModal(src, title) {
    document.getElementById('projModalImg').src = src;
    document.getElementById('projModalTitle').textContent = title;
    document.getElementById('projModal').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeProjModal() {
    document.getElementById('projModal').classList.remove('open');
    document.body.style.overflow = '';
  }

  // ── CERT GALLERY ──
  function filterCert(cat, btn) {
    document.querySelectorAll('.cert-tab').forEach(t => t.classList.remove('active'));
    if (btn) btn.classList.add('active');
    document.querySelectorAll('.cert-card').forEach(card => {
      card.classList.toggle('hidden', cat !== 'all' && card.dataset.category !== cat);
    });
  }

  function openModal(src, title, sub) {
    document.getElementById('modalImg').src = src;
    document.getElementById('modalTitle').textContent = title;
    document.getElementById('modalSub').textContent = sub;
    document.getElementById('certModal').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    document.getElementById('certModal').classList.remove('open');
    document.body.style.overflow = '';
  }

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') { closeModal(); closeProjModal(); }
  });

  window.addEventListener('load', () => {
    document.body.style.opacity = '0';
    document.body.style.transition = 'opacity 0.4s';
    setTimeout(() => document.body.style.opacity = '1', 50);
  });

  initSliders();

  /* ── IMAGE ZOOM IN / OUT FEATURE (ADD ONLY) ── */

let currentScale = 1;
let isDragging = false;
let startX, startY, translateX = 0, translateY = 0;

function enableZoom(imgId) {
  const img = document.getElementById(imgId);

  if (!img) return;

  img.style.cursor = "grab";
  img.style.transition = "transform 0.2s ease";

  currentScale = 1;
  translateX = 0;
  translateY = 0;
  updateTransform(img);

  img.onwheel = function(e) {
    e.preventDefault();

    if (e.deltaY < 0) {
      currentScale += 0.15;
    } else {
      currentScale -= 0.15;
      if (currentScale < 1) {
        currentScale = 1;
        translateX = 0;
        translateY = 0;
      }
    }

    updateTransform(img);
  };

  img.onmousedown = function(e) {
    if (currentScale <= 1) return;

    isDragging = true;
    img.style.cursor = "grabbing";

    startX = e.clientX - translateX;
    startY = e.clientY - translateY;
  };

  document.onmousemove = function(e) {
    if (!isDragging) return;

    translateX = e.clientX - startX;
    translateY = e.clientY - startY;

    updateTransform(img);
  };

  document.onmouseup = function() {
    isDragging = false;
    img.style.cursor = "grab";
  };

  function updateTransform(target) {
    target.style.transform =
      `translate(${translateX}px, ${translateY}px) scale(${currentScale})`;
  }
}

const oldOpenModal = openModal;
openModal = function(src, title, sub) {
  oldOpenModal(src, title, sub);

  setTimeout(() => {
    enableZoom("modalImg");
  }, 100);
};

const oldOpenProjModal = openProjModal;
openProjModal = function(src, title) {
  oldOpenProjModal(src, title);

  setTimeout(() => {
    enableZoom("projModalImg");
  }, 100);
};

/* ── PROJECT MODAL NEXT / PREV IMAGE FEATURE (ADD ONLY) ── */

let currentProjectImages = [];
let currentProjectIndex = 0;

function setupProjectModalNavigation() {
  document.querySelectorAll('.proj-img-slider').forEach(slider => {
    const images = [...slider.querySelectorAll('img')];

    images.forEach((img, index) => {
      img.onclick = function () {
        currentProjectImages = images.map(el => el.src);
        currentProjectIndex = index;

        openProjectModalByIndex();
      };
    });
  });
}

function openProjectModalByIndex() {
  const modal = document.getElementById("projModal");
  const modalImg = document.getElementById("projModalImg");
  const modalTitle = document.getElementById("projModalTitle");

  modalImg.src = currentProjectImages[currentProjectIndex];

  const currentImg = document.querySelector(
    `img[src="${currentProjectImages[currentProjectIndex]}"]`
  );

  modalTitle.textContent = currentImg
    ? currentImg.alt
    : "Project Preview";

  modal.classList.add("open");
  document.body.style.overflow = "hidden";

  setTimeout(() => {
    enableZoom("projModalImg");
  }, 100);
}

function nextProjectImage() {
  currentProjectIndex =
    (currentProjectIndex + 1) % currentProjectImages.length;

  openProjectModalByIndex();
}

function prevProjectImage() {
  currentProjectIndex =
    (currentProjectIndex - 1 + currentProjectImages.length) %
    currentProjectImages.length;

  openProjectModalByIndex();
}

const projModalInner = document.querySelector("#projModal .cert-modal-inner");

const prevBtn = document.createElement("button");
prevBtn.innerHTML = '<i class="fas fa-chevron-left"></i>';
prevBtn.className = "cert-modal-close";
prevBtn.style.left = "15px";
prevBtn.style.right = "auto";
prevBtn.onclick = function (e) {
  e.stopPropagation();
  prevProjectImage();
};

const nextBtn = document.createElement("button");
nextBtn.innerHTML = '<i class="fas fa-chevron-right"></i>';
nextBtn.className = "cert-modal-close";
nextBtn.style.right = "60px";
nextBtn.onclick = function (e) {
  e.stopPropagation();
  nextProjectImage();
};

projModalInner.appendChild(prevBtn);
projModalInner.appendChild(nextBtn);

document.addEventListener("keydown", function (e) {
  const modalOpen =
    document.getElementById("projModal").classList.contains("open");

  if (!modalOpen) return;

  if (e.key === "ArrowRight") {
    nextProjectImage();
  }

  if (e.key === "ArrowLeft") {
    prevProjectImage();
  }
});

  // ── NAVBAR ──
  function toggleMobileMenu() {
    document.getElementById('mobileMenu').classList.toggle('open');
  }
  function closeMobileMenu() {
    document.getElementById('mobileMenu').classList.remove('open');
  }

  // Highlight active nav link on scroll
  const sections = document.querySelectorAll('section[id], div.hero');
  const navLinks = document.querySelectorAll('.navbar-links a');
  window.addEventListener('scroll', () => {
    let current = '';
    sections.forEach(s => {
      if (window.scrollY >= s.offsetTop - 80) current = s.id || 'hero';
    });
    navLinks.forEach(a => {
      a.classList.remove('active');
      if (a.getAttribute('href') === '#' + current) a.classList.add('active');
    });
  });

setupProjectModalNavigation();

</script>
</body>
</html>