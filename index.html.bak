      <a href="mailto:zidanabsar03@gmail.com" style="color:var(--muted);font-size:1rem;transition:color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--muted)'"><i class="fas fa-envelope"></i></a>
      <a href="https://github.com/zabtsar" target="_blank" style="color:var(--muted);font-size:1rem;transition:color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--muted)'"><i class="fab fa-github"></i></a>
      <a href="https://www.linkedin.com/in/zidanabsarabdallah/" target="_blank" style="color:var(--muted);font-size:1rem;transition:color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--muted)'"><i class="fab fa-linkedin"></i></a>
