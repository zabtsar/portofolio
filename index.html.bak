<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Zidan Absar Abdallah | Developer & AI Enthusiast</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    :root {
      --bg: #0a0a0f;
      --surface: #111118;
      --surface2: #16161f;
      --border: rgba(255,255,255,0.07);
      --accent: #6c63ff;
      --accent2: #ff6584;
      --accent3: #43e97b;
      --text: #e8e8f0;
      --muted: #6b6b80;
      --heading: 'Syne', sans-serif;
      --body: 'DM Sans', sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    /* ── NAVBAR ── */
    .navbar {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 999;
      padding: 0.9rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(10,10,15,0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      transition: background 0.3s;
    }
    .navbar-logo {
      font-family: var(--heading);
      font-weight: 800;
      font-size: 1rem;
      color: var(--text);
      text-decoration: none;
      letter-spacing: -0.5px;
    }
    .navbar-logo span { color: var(--accent); }
    .navbar-links {
      display: flex;
      gap: 0.25rem;
      list-style: none;
    }
    .navbar-links a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 500;
      padding: 0.4rem 0.9rem;
      border-radius: 6px;
      transition: all 0.2s;
    }
    .navbar-links a:hover { color: var(--text); background: rgba(255,255,255,0.05); }
    .navbar-links a.active { color: var(--accent); }
    .navbar-cv {
      background: var(--accent);
      color: white !important;
      padding: 0.4rem 1rem !important;
      border-radius: 6px !important;
      font-weight: 600 !important;
    }
    .navbar-cv:hover { background: transparent !important; border: 1px solid var(--accent); color: var(--accent) !important; }
    .navbar-hamburger {
      display: none;
      background: none;
      border: none;
      color: var(--text);
      font-size: 1.2rem;
      cursor: pointer;
    }
    .navbar-mobile {
      display: none;
      flex-direction: column;
      position: fixed;
      top: 56px; left: 0; right: 0;
      background: rgba(10,10,15,0.97);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      padding: 1rem 2rem 1.5rem;
      z-index: 998;
      gap: 0.25rem;
    }
    .navbar-mobile.open { display: flex; }
    .navbar-mobile a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 500;
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--border);
      transition: color 0.2s;
    }
    .navbar-mobile a:hover { color: var(--text); }
    @media (max-width: 768px) {
      .navbar-links { display: none; }
      .navbar-hamburger { display: block; }
    }
    body {
      font-family: var(--body);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      overflow-x: hidden;
      padding-top: 56px;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
      opacity: 0.4;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 2rem;
      position: relative;
      z-index: 1;
    }

    .hero {
      height: 100vh;
      width: 100vw;
      margin-left: calc(-50vw + 50%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      padding: 0 2rem;
    }
    .hero .container { width: 100%; max-width: 1100px; }

    .hero-bg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
    .hero-blob { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.15; }
    .hero-blob-1 { width: 500px; height: 500px; background: var(--accent); top: -100px; left: -100px; animation: drift 8s ease-in-out infinite alternate; }
    .hero-blob-2 { width: 400px; height: 400px; background: var(--accent2); bottom: -50px; right: -80px; animation: drift 10s ease-in-out infinite alternate-reverse; }
    @keyframes drift { from { transform: translate(0,0) scale(1); } to { transform: translate(30px,20px) scale(1.05); } }

    /* ── HERO LAYOUT: photo left + text right ── */
    .hero-inner { display: grid; grid-template-columns: auto 1fr; gap: 5rem; align-items: center; width: 100%; max-width: 1100px; margin: 0 auto; }

    /* ── PHOTO ── */
    .hero-photo-wrap {
      position: relative;
      width: 260px;
      height: 260px;
      flex-shrink: 0;
    }
    .hero-photo-wrap::before {
      content: '';
      position: absolute;
      inset: -6px;
      border-radius: 50%;
      background: conic-gradient(var(--accent), var(--accent2), var(--accent3), var(--accent));
      animation: spinGlow 6s linear infinite;
      z-index: 0;
    }
    .hero-photo-wrap::after {
      content: '';
      position: absolute;
      inset: -24px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(108,99,255,0.22) 0%, transparent 70%);
      z-index: -1;
      animation: pulseGlow 3s ease-in-out infinite alternate;
    }
    @keyframes spinGlow { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    @keyframes pulseGlow { from { opacity: 0.4; transform: scale(1); } to { opacity: 0.9; transform: scale(1.08); } }

    .hero-photo-inner {
      position: relative;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      overflow: hidden;
      z-index: 1;
      border: 4px solid var(--bg);
      background: linear-gradient(135deg, var(--surface2), var(--surface));
    }
    .hero-photo-inner img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
      display: block;
    }
    .hero-photo-fallback {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
    }
    .hero-photo-fallback i { font-size: 5rem; color: white; }

    .hero-badge { display: inline-flex; align-items: center; gap: 8px; border: 1px solid rgba(108,99,255,0.4); background: rgba(108,99,255,0.1); color: #a09cff; padding: 0.4rem 1rem; border-radius: 40px; font-size: 0.82rem; font-weight: 500; letter-spacing: 0.5px; margin-bottom: 1.5rem; backdrop-filter: blur(10px); }

    .hero h1 { font-family: var(--heading); font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; line-height: 1.05; letter-spacing: -1px; margin-bottom: 1rem; }
    .hero h1 .name-highlight { background: linear-gradient(135deg, #6c63ff, #ff6584, #43e97b); background-size: 200%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: gradientShift 5s ease infinite; }
    @keyframes gradientShift { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }

    .hero-tagline { font-size: 1.1rem; color: var(--muted); margin-bottom: 1.5rem; font-weight: 300; }
    .hero-tagline strong { color: var(--accent3); font-weight: 500; }
    .hero-description { font-size: 1rem; color: #9090a8; max-width: 560px; line-height: 1.75; margin-bottom: 2.5rem; }
    .hero-cta { display: flex; gap: 1rem; flex-wrap: wrap; }

    .btn-primary { background: var(--accent); color: white; padding: 0.75rem 1.8rem; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: all 0.3s; border: 1px solid transparent; }
    .btn-primary:hover { background: transparent; border-color: var(--accent); color: var(--accent); transform: translateY(-2px); }
    .btn-ghost { background: transparent; color: var(--text); padding: 0.75rem 1.8rem; border-radius: 8px; text-decoration: none; font-weight: 500; font-size: 0.9rem; border: 1px solid var(--border); transition: all 0.3s; }
    .btn-ghost:hover { border-color: rgba(255,255,255,0.2); background: rgba(255,255,255,0.04); transform: translateY(-2px); }

    .hero-avatar { width: 180px; height: 180px; border-radius: 28px; background: linear-gradient(135deg, var(--surface2), var(--surface)); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; position: relative; flex-shrink: 0; }
    .hero-avatar::before { content: ''; position: absolute; inset: -1px; border-radius: 28px; background: linear-gradient(135deg, var(--accent), var(--accent2), var(--accent3)); z-index: -1; opacity: 0.5; }
    .hero-avatar i { font-size: 5rem; background: linear-gradient(135deg, var(--accent), var(--accent2)); -webkit-background-clip: text; background-clip: text; color: transparent; }

    section { padding: 5rem 0; border-top: 1px solid var(--border); }
    .section-label { font-family: var(--heading); font-size: 0.75rem; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--accent); margin-bottom: 0.75rem; }
    .section-title { font-family: var(--heading); font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 800; letter-spacing: -0.5px; margin-bottom: 3rem; color: var(--text); }

    .skills-categories { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; }
    .skill-category { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; transition: all 0.3s; }
    .skill-category:hover { border-color: rgba(108,99,255,0.3); transform: translateY(-4px); box-shadow: 0 20px 40px rgba(0,0,0,0.3); }
    .skill-category-title { font-family: var(--heading); font-size: 0.78rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); margin-bottom: 1rem; display: flex; align-items: center; gap: 8px; }
    .skill-category-title i { color: var(--accent); }
    .skill-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .skill-tag { background: rgba(255,255,255,0.04); border: 1px solid var(--border); color: #c0c0d8; padding: 0.3rem 0.8rem; border-radius: 6px; font-size: 0.82rem; font-weight: 500; transition: all 0.2s; }
    .skill-tag:hover { background: rgba(108,99,255,0.15); border-color: rgba(108,99,255,0.4); color: #a09cff; }

    /* ── PROJECT SLIDER ── */
    .projects-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
  align-items: stretch;
}

.project-card {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.project-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.project-card p {
  flex: 1;
}

    .project-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; transition: all 0.3s; position: relative; padding: 0; }
    .project-card:hover { transform: translateY(-6px); border-color: rgba(108,99,255,0.3); box-shadow: 0 24px 48px rgba(0,0,0,0.4); }

    .project-body { padding: 1.5rem; }
    .project-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; font-size: 1.3rem; }
    .project-card h3 { font-family: var(--heading); font-size: 1.1rem; font-weight: 700; margin-bottom: 0.6rem; color: var(--text); }
    .project-card p { color: var(--muted); font-size: 0.88rem; line-height: 1.65; }
    .project-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1rem; }
    .project-tag { font-size: 0.72rem; font-weight: 600; padding: 0.2rem 0.6rem; border-radius: 4px; letter-spacing: 0.3px; }

    .proj-img-slider { position: relative; aspect-ratio: 16/9; overflow: hidden; background: var(--surface2); cursor: zoom-in; }
    .proj-slides { display: flex; height: 100%; transition: transform 0.4s cubic-bezier(0.4,0,0.2,1); }
    .proj-slides img { min-width: 100%; height: 100%; object-fit: cover; flex-shrink: 0; }

    .slide-btn { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.6); border: none; color: white; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; font-size: 0.75rem; display: flex; align-items: center; justify-content: center; transition: background 0.2s; z-index: 2; opacity: 0; }
    .proj-img-slider:hover .slide-btn { opacity: 1; }
    .slide-btn:hover { background: var(--accent); }
    .slide-btn.prev { left: 8px; }
    .slide-btn.next { right: 8px; }

    .slide-dots { position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%); display: flex; gap: 5px; z-index: 2; }
    .slide-dot { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,0.4); cursor: pointer; transition: background 0.2s; border: none; }
    .slide-dot.active { background: white; }

    /* ── TWO COL ── */
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
    .panel { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 2rem; }
    .panel-title { font-family: var(--heading); font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 10px; }
    .panel-title i { color: var(--accent); font-size: 1rem; }
    .cert-item { display: flex; gap: 12px; margin-bottom: 1.2rem; align-items: flex-start; padding: 0.8rem; border-radius: 10px; transition: background 0.2s; }
    .cert-item:hover { background: rgba(255,255,255,0.03); }
    .cert-icon { width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.9rem; }
    .cert-info strong { display: block; font-size: 0.88rem; font-weight: 600; color: var(--text); margin-bottom: 2px; }
    .cert-info span { font-size: 0.78rem; color: var(--muted); }

    /* ── CERT GALLERY ── */
    .cert-tabs { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .cert-tab { background: transparent; border: 1px solid var(--border); color: var(--muted); padding: 0.5rem 1.2rem; border-radius: 40px; font-size: 0.85rem; font-weight: 500; cursor: pointer; transition: all 0.2s; font-family: var(--body); }
    .cert-tab:hover, .cert-tab.active { background: var(--accent); border-color: var(--accent); color: white; }

    .cert-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.2rem; }
    .cert-card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; cursor: pointer; transition: all 0.3s; }
    .cert-card:hover { transform: translateY(-4px); border-color: rgba(108,99,255,0.4); box-shadow: 0 16px 32px rgba(0,0,0,0.4); }
    .cert-card-img { position: relative; aspect-ratio: 4/3; overflow: hidden; background: var(--surface2); }
    .cert-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
    .cert-card:hover .cert-card-img img { transform: scale(1.05); }
    .cert-card-overlay { position: absolute; inset: 0; background: rgba(108,99,255,0.75); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; opacity: 0; transition: opacity 0.3s; color: white; font-weight: 600; font-size: 0.9rem; backdrop-filter: blur(4px); }
    .cert-card-overlay i { font-size: 1.5rem; }
    .cert-card:hover .cert-card-overlay { opacity: 1; }
    .cert-card-info { padding: 0.9rem 1rem; }
    .cert-card-info strong { display: block; font-size: 0.85rem; color: var(--text); margin-bottom: 3px; }
    .cert-card-info span { font-size: 0.75rem; color: var(--muted); }
    .cert-card.hidden { display: none; }

    /* ── MODAL ── */
    .cert-modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 1000; align-items: center; justify-content: center; backdrop-filter: blur(8px); padding: 2rem; }
    .cert-modal.open { display: flex; }
    .cert-modal-inner { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; max-width: 800px; width: 100%; overflow: hidden; position: relative; animation: modalIn 0.3s ease; }
    @keyframes modalIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
    .cert-modal-inner img { width: 100%; display: block; }
    .cert-modal-caption { padding: 1.2rem 1.5rem; }
    .cert-modal-caption strong { display: block; font-size: 1rem; color: var(--text); margin-bottom: 4px; }
    .cert-modal-caption span { font-size: 0.85rem; color: var(--muted); }
    .cert-modal-close { position: absolute; top: 12px; right: 12px; background: rgba(0,0,0,0.5); border: none; color: white; width: 34px; height: 34px; border-radius: 50%; cursor: pointer; font-size: 0.9rem; display: flex; align-items: center; justify-content: center; transition: background 0.2s; }
    .cert-modal-close:hover { background: var(--accent); }

    /* ── CONTACT ── */
    .contact-panel { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 3rem; text-align: center; position: relative; overflow: hidden; }
    .contact-panel::before { content: ''; position: absolute; width: 300px; height: 300px; background: var(--accent); border-radius: 50%; filter: blur(100px); opacity: 0.06; top: -100px; left: 50%; transform: translateX(-50%); }
    .contact-panel h2 { font-family: var(--heading); font-size: 2rem; font-weight: 800; margin-bottom: 0.75rem; position: relative; z-index: 1; }
    .contact-panel p { color: var(--muted); margin-bottom: 2rem; font-size: 0.95rem; position: relative; z-index: 1; }
    .contact-links { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; position: relative; z-index: 1; }
    .contact-btn { display: inline-flex; align-items: center; gap: 8px; padding: 0.65rem 1.3rem; border-radius: 8px; text-decoration: none; font-size: 0.88rem; font-weight: 500; border: 1px solid var(--border); color: var(--text); background: rgba(255,255,255,0.03); transition: all 0.3s; }
    .contact-btn:hover { background: var(--accent); border-color: var(--accent); transform: translateY(-2px); }

    footer { border-top: 1px solid var(--border); padding: 2rem 0; text-align: center; color: var(--muted); font-size: 0.82rem; }

    /* ── ABOUT ── */
    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
    .about-text p { color: #9090a8; line-height: 1.8; margin-bottom: 1rem; font-size: 0.95rem; }
    .about-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2rem; }
    .stat-box { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.2rem; text-align: center; }
    .stat-box .stat-num { font-family: var(--heading); font-size: 1.8rem; font-weight: 800; color: var(--accent); }
    .stat-box .stat-label { font-size: 0.78rem; color: var(--muted); margin-top: 4px; }
    .about-img-wrap { position: relative; }
    .about-card { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 2rem; text-align: center; }
    .about-avatar { width: 100px; height: 100px; border-radius: 50%; background: linear-gradient(135deg, var(--accent), var(--accent2)); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 2.5rem; color: white; overflow: hidden; }
    .about-avatar img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
    .about-card h3 { font-family: var(--heading); font-weight: 700; font-size: 1.1rem; margin-bottom: 4px; }
    .about-card span { font-size: 0.82rem; color: var(--muted); }
    .about-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: center; margin-top: 1rem; }
    .about-tag { font-size: 0.75rem; padding: 0.25rem 0.7rem; border-radius: 20px; background: rgba(108,99,255,0.15); color: #a09cff; border: 1px solid rgba(108,99,255,0.25); }
    @media (max-width: 768px) { .about-grid { grid-template-columns: 1fr; } }

    /* ── EXPERIENCE ── */
    .exp-timeline { display: flex; flex-direction: column; gap: 1.5rem; }
    .exp-item { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem 1.75rem; position: relative; transition: all 0.3s; }
    .exp-item:hover { border-color: rgba(108,99,255,0.3); transform: translateX(4px); }
    .exp-item::before { content: ''; position: absolute; left: -1px; top: 20px; bottom: 20px; width: 3px; border-radius: 2px; background: linear-gradient(to bottom, var(--accent), var(--accent2)); opacity: 0; transition: opacity 0.3s; }
    .exp-item:hover::before { opacity: 1; }
    .exp-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
    .exp-title { font-family: var(--heading); font-weight: 700; font-size: 1rem; color: var(--text); }
    .exp-company { font-size: 0.85rem; color: var(--accent); font-weight: 500; margin-top: 2px; }
    .exp-date { font-size: 0.78rem; color: var(--muted); background: rgba(255,255,255,0.04); border: 1px solid var(--border); padding: 0.25rem 0.7rem; border-radius: 20px; white-space: nowrap; }
    .exp-desc { color: #9090a8; font-size: 0.88rem; line-height: 1.7; margin-top: 0.75rem; }
    .exp-desc li { margin-bottom: 0.3rem; margin-left: 1.2rem; }

    /* ── PROJECT LINKS ── */
    .project-links { display: flex; gap: 0.5rem; margin-top: 1rem; flex-wrap: wrap; }
    .proj-link-btn { display: inline-flex; align-items: center; gap: 5px; font-size: 0.75rem; font-weight: 600; padding: 0.3rem 0.8rem; border-radius: 6px; text-decoration: none; border: 1px solid var(--border); color: var(--muted); background: rgba(255,255,255,0.03); transition: all 0.2s; }
    .proj-link-btn:hover { background: var(--accent); border-color: var(--accent); color: white; }
    .proj-link-btn.live { border-color: rgba(67,233,123,0.4); color: #43e97b; background: rgba(67,233,123,0.07); }
    .proj-link-btn.live:hover { background: #43e97b; color: #0a0a0f; border-color: #43e97b; }

    @media (max-width: 768px) {
      .hero-inner { grid-template-columns: 1fr; justify-items: center; gap: 2.5rem; }
      .hero-photo-wrap { width: 200px; height: 200px; }
      .hero-content { text-align: center; }
      .hero-badge { justify-content: center; }
      .hero-cta { justify-content: center; }
      .two-col { grid-template-columns: 1fr; }
      .skills-categories { grid-template-columns: 1fr 1fr; }
      .projects-grid {
  grid-template-columns: 1fr;
}
    }
    @media (max-width: 480px) { .skills-categories { grid-template-columns: 1fr; } }

    .fade-up { opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
    .fade-up.visible { opacity: 1; transform: translateY(0); }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 3px; }
  </style>
</head>
